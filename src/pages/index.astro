---
import Base from '../layouts/Base.astro';
import SeasonExplorer from '../components/SeasonExplorer.astro';
import { dayLabel } from '../lib/chart.js';
import { SEASON_NAMES, MAX_YEARS } from '../lib/season-chart.js';

// Resolved at build time — the deployed page is static, no runtime fetch.
const modules = import.meta.glob('../../data/era5/*.json', { eager: true });
const manifest = modules['../../data/era5/index.json'].default;

const files = Object.entries(modules)
  .filter(([path]) => !path.endsWith('index.json'))
  .map(([, module]) => module.default);

// The `time` array is dropped from the inlined payload: every date is
// recoverable from `start` plus the index, which roughly halves the page.
const dataset = {};
for (const file of files) {
  const season = (dataset[file.season] ??= { name: SEASON_NAMES[file.season], years: {} });
  season.years[file.season_year] = {
    start: file.time[0],
    days: file.days,
    complete: file.complete,
    mean: file.tasmean,
    min: file.tasmin,
    max: file.tasmax,
  };
}

// The season holding the newest observation leads the chart.
const latest = files.reduce((a, b) => (b.time[b.days - 1] > a.time[a.days - 1] ? b : a));
const defaultSeason = latest.season;
const defaultYears = Object.keys(dataset[defaultSeason].years)
  .map(Number)
  .sort((a, b) => b - a)
  .slice(0, 3);

const firstYear = Math.min(...files.map((file) => file.season_year));
const lastYear = Math.max(...files.map((file) => file.season_year));

// Highest daily maximum anywhere in the record.
const hottest = files.reduce(
  (best, file) => {
    const index = file.tasmax.indexOf(Math.max(...file.tasmax));
    const value = file.tasmax[index];
    return value > best.value
      ? { value, date: file.time[index], season: SEASON_NAMES[file.season] }
      : best;
  },
  { value: -Infinity, date: null, season: null }
);
---

<Base
  title="Barcelona Climate Tracker"
  description="Daily ERA5 temperature for Barcelona, compared season by season across 2000–2026."
>
  <header class="page-header">
    <h1>Barcelona Climate Tracker</h1>
    <p>
      Daily minimum, mean and maximum 2m temperature for {manifest.location.name}
      ({manifest.location.latitude}°N, {manifest.location.longitude}°E), {firstYear} to {lastYear},
      from the {manifest.source}. Each season is charted on its own so any {MAX_YEARS} years can be
      laid over one another day for day.
    </p>
  </header>

  <section class="card hero">
    <p class="stat-label">Hottest day on record, {firstYear}–{lastYear}</p>
    <p class="stat-value">{hottest.value.toFixed(1)}°C</p>
    <p class="stat-detail">{dayLabel(hottest.date)} · daily maximum</p>
  </section>

  <SeasonExplorer
    dataset={dataset}
    defaultSeason={defaultSeason}
    defaultYears={defaultYears}
    defaultVariable="mean"
  />

  <footer class="page-footer">
    <p>
      Source: {manifest.source}. Daily statistics aggregated from hourly 2m temperature in UTC,
      so daily extremes sit fractionally inside the true local ones. Values in °C. Winter is
      labelled by its January — DJF {lastYear} is December {lastYear - 1} through February {lastYear}.
    </p>
  </footer>
</Base>
