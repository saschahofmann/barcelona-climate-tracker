---
import Base from '../layouts/Base.astro';
import SeasonExplorer from '../components/SeasonExplorer.astro';
import { dayLabel } from '../lib/chart.js';
import { SEASON_NAMES, MAX_YEARS } from '../lib/season-chart.js';

// Resolved at build time — the deployed page is static, no runtime fetch.
const modules = import.meta.glob('../../data/era5/*.json', { eager: true });
const manifest = modules['../../data/era5/index.json'].default;

const files = Object.entries(modules)
  .filter(([path]) => !path.endsWith('index.json'))
  .map(([, module]) => module.default);

// The `time` array is dropped from the inlined payload: every date is
// recoverable from `start` plus the index, which roughly halves the page.
const dataset = {};
for (const file of files) {
  const season = (dataset[file.season] ??= { name: SEASON_NAMES[file.season], years: {} });
  season.years[file.season_year] = {
    start: file.time[0],
    days: file.days,
    complete: file.complete,
    mean: file.tasmean,
    min: file.tasmin,
    max: file.tasmax,
  };
}

// The season holding the newest observation leads the page.
const latest = files.reduce((a, b) => (b.time[b.days - 1] > a.time[a.days - 1] ? b : a));
const defaultSeason = latest.season;
const defaultYears = Object.keys(dataset[defaultSeason].years)
  .map(Number)
  .sort((a, b) => b - a)
  .slice(0, 3);

const average = (values) => values.reduce((acc, v) => acc + v, 0) / values.length;
const one = (v) => v.toFixed(1);
const signed = (v) => `${v >= 0 ? '+' : '−'}${Math.abs(v).toFixed(1)}`;

const lastIndex = latest.days - 1;
const latestMean = latest.tasmean[lastIndex];

// Every prior year of this season, clipped to the same window, is the baseline.
const priorSeasons = files.filter(
  (file) => file.season === latest.season && file.season_year !== latest.season_year
);
const baseline = average(
  priorSeasons.map((file) => average(file.tasmean.slice(0, latest.days)))
);
const toDate = average(latest.tasmean);

const sameDay = priorSeasons
  .map((file) => file.tasmean[lastIndex])
  .filter((value) => value != null);
const sameDayBaseline = sameDay.length ? average(sameDay) : null;

const warmest = latest.tasmax.indexOf(Math.max(...latest.tasmax));
const coolest = latest.tasmin.indexOf(Math.min(...latest.tasmin));

const seasonName = SEASON_NAMES[latest.season];
const currentLabel = `${seasonName} ${latest.season_year}`;
const firstYear = Math.min(...files.map((file) => file.season_year));
const lastYear = Math.max(...files.map((file) => file.season_year));
const baselineSpan = `${firstYear}–${lastYear - 1}`;
---

<Base
  title="Barcelona Climate Tracker"
  description="Daily ERA5 temperature for Barcelona, compared season by season across 2000–2026."
>
  <header class="page-header">
    <h1>Barcelona Climate Tracker</h1>
    <p>
      Daily minimum, mean and maximum 2m temperature for {manifest.location.name}
      ({manifest.location.latitude}°N, {manifest.location.longitude}°E), {firstYear} to {lastYear},
      from the {manifest.source}. Each season is charted on its own so any {MAX_YEARS} years can be
      laid over one another day for day.
    </p>
  </header>

  <section class="summary">
    <div class="card hero">
      <p class="stat-label">Mean temperature, {dayLabel(latest.time[lastIndex])}</p>
      <p class="stat-value">{one(latestMean)}°C</p>
      <p class="stat-detail">
        {
          sameDayBaseline != null
            ? `${signed(latestMean - sameDayBaseline)}°C against the ${baselineSpan} average for this day`
            : 'No prior years on record for this day'
        }
      </p>
    </div>

    <div class="card">
      <p class="stat-label">{currentLabel} so far</p>
      <p class="stat-value">{one(toDate)}°C</p>
      <p class="stat-detail">
        {signed(toDate - baseline)}°C against {baselineSpan} over the same {latest.days} days
      </p>
    </div>

    <div class="card">
      <p class="stat-label">Warmest day, {currentLabel}</p>
      <p class="stat-value">{one(latest.tasmax[warmest])}°C</p>
      <p class="stat-detail">{dayLabel(latest.time[warmest])}</p>
    </div>

    <div class="card">
      <p class="stat-label">Coolest night, {currentLabel}</p>
      <p class="stat-value">{one(latest.tasmin[coolest])}°C</p>
      <p class="stat-detail">{dayLabel(latest.time[coolest])}</p>
    </div>
  </section>

  <SeasonExplorer
    dataset={dataset}
    defaultSeason={defaultSeason}
    defaultYears={defaultYears}
    defaultVariable="mean"
  />

  <footer class="page-footer">
    <p>
      Source: {manifest.source}. Daily statistics aggregated from hourly 2m temperature in UTC,
      so daily extremes sit fractionally inside the true local ones. Values in °C. Winter is
      labelled by its January — DJF {lastYear} is December {lastYear - 1} through February {lastYear}.
    </p>
  </footer>
</Base>
