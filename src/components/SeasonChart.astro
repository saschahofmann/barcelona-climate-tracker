---
import { niceTicks, r2 } from '../lib/chart.js';

// Day and month only — the year is already on the label beside it.
const shortDay = (iso) =>
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }).format(
    new Date(`${iso}T00:00:00Z`)
  );

const { season, name, years } = Astro.props;

// Most recent year is the focus; everything before it is context.
const focus = years[years.length - 1];
const priors = years.slice(0, -1);

const W = 900;
const H = 360;
// Right padding holds the end-of-line year labels.
const PAD = { top: 18, right: 66, bottom: 30, left: 44 };
const plotW = W - PAD.left - PAD.right;
const plotH = H - PAD.top - PAD.bottom;

const maxDays = Math.max(...years.map((year) => year.days));
// The longest year supplies the x-axis month ticks.
const spine = years.find((year) => year.days === maxDays);

const scale = niceTicks(
  Math.min(...years.flatMap((year) => year.tasmin)),
  Math.max(...years.flatMap((year) => year.tasmax)),
  5
);

const xAt = (i) => PAD.left + (i / (maxDays - 1)) * plotW;
const yAt = (v) => PAD.top + (1 - (v - scale.min) / (scale.max - scale.min)) * plotH;

const linePath = (values) =>
  values.map((v, i) => `${i ? 'L' : 'M'}${r2(xAt(i))},${r2(yAt(v))}`).join('');

// Focus band runs along the highs, then back along the lows.
let bandPath = '';
for (let i = 0; i < focus.days; i++) {
  bandPath += `${i ? 'L' : 'M'}${r2(xAt(i))},${r2(yAt(focus.tasmax[i]))}`;
}
for (let i = focus.days - 1; i >= 0; i--) {
  bandPath += `L${r2(xAt(i))},${r2(yAt(focus.tasmin[i]))}`;
}
bandPath += 'Z';

const monthTicks = spine.time
  .map((iso, i) => ({ iso, i }))
  .filter(({ iso }) => iso.endsWith('-01'))
  .map(({ iso, i }) => ({
    x: r2(xAt(i)),
    label: new Intl.DateTimeFormat('en-GB', { month: 'short', timeZone: 'UTC' }).format(
      new Date(`${iso}T00:00:00Z`)
    ),
  }));

const endLabel = (year) => ({
  x: r2(xAt(year.days - 1) + 10),
  y: r2(yAt(year.tasmean[year.days - 1]) + 4),
  text: String(year.season_year),
});

const baselineY = PAD.top + plotH;

const clientConfig = {
  W,
  padLeft: PAD.left,
  plotW,
  maxDays,
  years: years.map((year) => ({
    label: year.season_year,
    time: year.time,
    mean: year.tasmean,
    min: year.tasmin,
    max: year.tasmax,
    isFocus: year.season_year === focus.season_year,
  })),
};
---

<figure class="chart" data-season={season}>
  <div class="legend">
    {
      years.map((year) => (
        <span class="legend-item">
          <span
            class:list={['key', year.season_year === focus.season_year ? 'key-focus' : 'key-prior']}
          />
          {year.season_year}
          {!year.complete && <em>to {shortDay(year.time[year.days - 1])}</em>}
        </span>
      ))
    }
    <span class="legend-item legend-band">
      <span class="key key-band" />
      {focus.season_year} daily low–high
    </span>
  </div>

  <svg
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label={`${name} daily temperature in Barcelona, comparing ${years.map((y) => y.season_year).join(' and ')}. Shaded band is the ${focus.season_year} daily low to high range.`}
  >
    <g class="grid">
      {
        scale.ticks.map((tick) => (
          <line x1={PAD.left} x2={W - PAD.right} y1={r2(yAt(tick))} y2={r2(yAt(tick))} />
        ))
      }
    </g>

    <path class="band" d={bandPath} />

    {priors.map((year) => <path class="line-prior" d={linePath(year.tasmean)} />)}
    <path class="line-focus" d={linePath(focus.tasmean)} />

    <line class="baseline" x1={PAD.left} x2={W - PAD.right} y1={baselineY} y2={baselineY} />

    <g class="tick y">
      {
        scale.ticks.map((tick) => (
          <text x={PAD.left - 10} y={r2(yAt(tick)) + 4} text-anchor="end">
            {tick}°
          </text>
        ))
      }
    </g>
    <g class="tick x">
      {
        monthTicks.map((tick) => (
          <text x={tick.x} y={H - 9} text-anchor="middle">
            {tick.label}
          </text>
        ))
      }
    </g>

    <g class="crosshair">
      <line y1={PAD.top} y2={baselineY} x1="0" x2="0" />
      {years.map(() => <circle r="4" cx="0" cy="0" />)}
    </g>

    {
      priors.map((year) => (
        <text class="end-label end-prior" x={endLabel(year).x} y={endLabel(year).y}>
          {endLabel(year).text}
        </text>
      ))
    }
    <circle
      class="end-dot"
      cx={r2(xAt(focus.days - 1))}
      cy={r2(yAt(focus.tasmean[focus.days - 1]))}
      r="4"
    />
    <text class="end-label end-focus" x={endLabel(focus).x} y={endLabel(focus).y}>
      {endLabel(focus).text}
    </text>
  </svg>

  <div class="tooltip" hidden></div>
  <script type="application/json" set:html={JSON.stringify(clientConfig)}></script>
</figure>

<style>
  .chart {
    position: relative;
    margin: 0;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    margin-bottom: 0.75rem;
    color: var(--text-secondary);
    font-size: 0.82rem;
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .legend-item em {
    color: var(--text-muted);
    font-style: normal;
  }

  .key {
    width: 16px;
    height: 2px;
    border-radius: 1px;
    flex: none;
  }

  .key-focus {
    background: var(--series-temp);
  }

  .key-prior {
    background: var(--text-muted);
  }

  .key-band {
    height: 10px;
    border-radius: 2px;
    background: var(--series-temp);
    opacity: 0.18;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    touch-action: pan-y;
  }

  .grid line {
    stroke: var(--grid);
    stroke-width: 1;
  }

  .baseline {
    stroke: var(--axis);
    stroke-width: 1;
  }

  .band {
    fill: var(--series-temp);
    fill-opacity: 0.13;
  }

  /* Prior years recede to gray — hue is reserved for the year in focus. */
  .line-prior {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-linecap: round;
    opacity: 0.75;
  }

  .line-focus {
    fill: none;
    stroke: var(--series-temp);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .end-dot {
    fill: var(--series-temp);
    stroke: var(--surface-1);
    stroke-width: 2;
  }

  .end-label {
    font-size: 12px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .end-focus {
    fill: var(--text-primary);
  }

  .end-prior {
    fill: var(--text-muted);
  }

  .tick text {
    fill: var(--text-muted);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .crosshair {
    opacity: 0;
    pointer-events: none;
  }

  .chart.is-active .crosshair {
    opacity: 1;
  }

  .crosshair line {
    stroke: var(--axis);
    stroke-width: 1;
  }

  .crosshair circle {
    fill: var(--text-muted);
    stroke: var(--surface-1);
    stroke-width: 2;
  }

  .crosshair circle:last-of-type {
    fill: var(--series-temp);
  }

  .tooltip {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    pointer-events: none;
    display: grid;
    gap: 0.15rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface-1);
    color: var(--text-secondary);
    font-size: 0.78rem;
    line-height: 1.35;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.08);
  }

  .tooltip :global(strong) {
    color: var(--text-primary);
  }

  .tooltip :global(.row-focus) {
    color: var(--text-primary);
    font-weight: 600;
  }

  /* `display: grid` above would otherwise beat the [hidden] attribute. */
  .tooltip[hidden] {
    display: none;
  }
</style>

<script>
  const dateFmt = new Intl.DateTimeFormat('en-GB', {
    day: 'numeric',
    month: 'short',
    timeZone: 'UTC',
  });

  document.querySelectorAll('.chart[data-season]').forEach((root) => {
    const svg = root.querySelector('svg');
    const tooltip = root.querySelector('.tooltip');
    const crosshair = root.querySelector('.crosshair');
    const crossLine = crosshair.querySelector('line');
    const crossDots = [...crosshair.querySelectorAll('circle')];
    const cfg = JSON.parse(root.querySelector('script[type="application/json"]').textContent);

    // The y scale is baked into the SVG, so recover it from the rendered band
    // rather than duplicating the domain maths here.
    const yFromAttr = (el, attr) => Number(el.getAttribute(attr));
    const meanPaths = [
      ...root.querySelectorAll('.line-prior'),
      root.querySelector('.line-focus'),
    ];

    const xAt = (i) => cfg.padLeft + (i / (cfg.maxDays - 1)) * cfg.plotW;

    // Sample each mean path once to build an index -> y lookup.
    const yLookup = meanPaths.map((path) => {
      const points = path.getAttribute('d').slice(1).split('L');
      return points.map((point) => Number(point.split(',')[1]));
    });

    function move(event) {
      const rect = svg.getBoundingClientRect();
      const ratio = (((event.clientX - rect.left) / rect.width) * cfg.W - cfg.padLeft) / cfg.plotW;
      const i = Math.max(0, Math.min(cfg.maxDays - 1, Math.round(ratio * (cfg.maxDays - 1))));

      const x = xAt(i);
      crossLine.setAttribute('x1', x);
      crossLine.setAttribute('x2', x);

      const rows = [];
      cfg.years.forEach((year, seriesIndex) => {
        const dot = crossDots[seriesIndex];
        const value = year.mean[i];

        if (value == null) {
          dot.setAttribute('opacity', '0');
          return;
        }

        dot.setAttribute('opacity', '1');
        dot.setAttribute('cx', x);
        dot.setAttribute('cy', yLookup[seriesIndex][i]);

        rows.push(
          `<span class="${year.isFocus ? 'row-focus' : ''}">${year.label} · ` +
            `${value.toFixed(1)}° <span>(${year.min[i].toFixed(1)}–${year.max[i].toFixed(1)})</span></span>`
        );
      });

      // Every year shares a day index, so any year with data names the day.
      const withData = cfg.years.find((year) => year.time[i] != null);
      const heading = dateFmt.format(new Date(`${withData.time[i]}T00:00:00Z`));

      root.classList.add('is-active');
      tooltip.hidden = false;
      tooltip.innerHTML = `<strong>${heading}</strong>${rows.join('')}`;

      const half = tooltip.offsetWidth / 2;
      const px = (x / cfg.W) * rect.width;
      tooltip.style.left = `${Math.max(half, Math.min(rect.width - half, px))}px`;
    }

    function hide() {
      root.classList.remove('is-active');
      tooltip.hidden = true;
    }

    svg.addEventListener('pointermove', move);
    svg.addEventListener('pointerdown', move);
    svg.addEventListener('pointerleave', hide);
  });
</script>
