---
import { niceTicks, r2 } from '../lib/chart.js';

const { months, unit } = Astro.props;

const W = 900;
const H = 260;
const PAD = { top: 22, right: 16, bottom: 28, left: 46 };
const plotW = W - PAD.left - PAD.right;
const plotH = H - PAD.top - PAD.bottom;

const scale = niceTicks(0, Math.max(...months.map((m) => m.precipitation)), 4);
const baselineY = PAD.top + plotH;

const band = plotW / months.length;
const barW = Math.min(24, band - 2); // 2px surface gap between neighbours
const yAt = (v) => PAD.top + (1 - v / scale.max) * plotH;

/** Column with a 4px rounded cap, square where it meets the baseline. */
function columnPath(x, y, w, h) {
  const radius = Math.min(4, w / 2, h);
  return [
    `M${r2(x)},${r2(y + h)}`,
    `L${r2(x)},${r2(y + radius)}`,
    `Q${r2(x)},${r2(y)} ${r2(x + radius)},${r2(y)}`,
    `L${r2(x + w - radius)},${r2(y)}`,
    `Q${r2(x + w)},${r2(y)} ${r2(x + w)},${r2(y + radius)}`,
    `L${r2(x + w)},${r2(y + h)}`,
    'Z',
  ].join('');
}

const wettest = months.reduce((a, b) => (b.precipitation > a.precipitation ? b : a));

const columns = months.map((month, i) => {
  const x = PAD.left + i * band + (band - barW) / 2;
  const y = yAt(month.precipitation);
  return {
    ...month,
    x,
    y,
    height: baselineY - y,
    centre: x + barW / 2,
    bandX: PAD.left + i * band,
    isWettest: month.key === wettest.key,
  };
});

const wettestCol = columns.find((col) => col.isWettest);
---

<figure class="chart" data-chart="precipitation">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label={`Monthly precipitation totals for Barcelona. Wettest month was ${wettest.label} ${wettest.year} at ${Math.round(wettest.precipitation)}${unit}.`}
  >
    <g class="grid">
      {
        scale.ticks.map((tick) => (
          <line x1={PAD.left} x2={W - PAD.right} y1={r2(yAt(tick))} y2={r2(yAt(tick))} />
        ))
      }
    </g>

    <g class="bars">
      {
        columns.map((col) =>
          col.height > 0.5 ? (
            <path d={columnPath(col.x, col.y, barW, col.height)} />
          ) : null
        )
      }
    </g>

    <line class="baseline" x1={PAD.left} x2={W - PAD.right} y1={baselineY} y2={baselineY} />

    <g class="tick y">
      {
        scale.ticks.map((tick) => (
          <text x={PAD.left - 10} y={r2(yAt(tick)) + 4} text-anchor="end">
            {tick}
          </text>
        ))
      }
    </g>
    <g class="tick x">
      {
        columns.map((col) => (
          <text x={r2(col.centre)} y={H - 8} text-anchor="middle">
            {col.label}
          </text>
        ))
      }
    </g>

    {/* Label the extreme only — a value on every column would go unread. */}
    <text class="peak-label" x={r2(wettestCol.centre)} y={r2(wettestCol.y - 8)} text-anchor="middle">
      {Math.round(wettest.precipitation)} {unit}
    </text>

    <g class="hit">
      {
        columns.map((col) => (
          <rect
            x={r2(col.bandX)}
            y={PAD.top}
            width={r2(band)}
            height={plotH}
            data-label={`${col.label} ${col.year}`}
            data-value={`${Math.round(col.precipitation)} ${unit}`}
            data-centre={r2(col.centre)}
          />
        ))
      }
    </g>
  </svg>

  <div class="tooltip" hidden></div>
</figure>

<style>
  .chart {
    position: relative;
    margin: 0;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .grid line {
    stroke: var(--grid);
    stroke-width: 1;
  }

  .baseline {
    stroke: var(--axis);
    stroke-width: 1;
  }

  .bars path {
    fill: var(--series-precip);
  }

  .tick text {
    fill: var(--text-muted);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .peak-label {
    fill: var(--text-primary);
    font-size: 12px;
    font-weight: 600;
  }

  .hit rect {
    fill: transparent;
  }

  .hit rect:hover {
    fill: var(--text-primary);
    fill-opacity: 0.04;
  }

  .tooltip {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    pointer-events: none;
    display: grid;
    gap: 0.1rem;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface-1);
    color: var(--text-secondary);
    font-size: 0.78rem;
    line-height: 1.35;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.08);
  }

  .tooltip :global(strong) {
    color: var(--text-primary);
  }

  /* `display: grid` above would otherwise beat the [hidden] attribute. */
  .tooltip[hidden] {
    display: none;
  }
</style>

<script>
  const root = document.querySelector('[data-chart="precipitation"]');

  if (root) {
    const svg = root.querySelector('svg');
    const tooltip = root.querySelector('.tooltip');
    const viewBoxWidth = svg.viewBox.baseVal.width;

    root.querySelectorAll('.hit rect').forEach((hit) => {
      hit.addEventListener('pointerenter', () => {
        tooltip.hidden = false;
        tooltip.innerHTML =
          `<strong>${hit.dataset.label}</strong><span>${hit.dataset.value}</span>`;

        const rect = svg.getBoundingClientRect();
        const px = (Number(hit.dataset.centre) / viewBoxWidth) * rect.width;
        const half = tooltip.offsetWidth / 2;
        tooltip.style.left = `${Math.max(half, Math.min(rect.width - half, px))}px`;
      });
    });

    svg.addEventListener('pointerleave', () => {
      tooltip.hidden = true;
    });
  }
</script>
