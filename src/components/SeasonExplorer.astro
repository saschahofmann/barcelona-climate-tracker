---
import {
  buildModel,
  renderSvg,
  MAX_YEARS,
  MEASURES,
  STATS,
  DETAILS,
  SEASON_NAMES,
  W,
  H,
} from '../lib/season-chart.js';

// A pseudo-season covering the calendar year. It is assembled in the browser
// from the four real seasons, so it needs no extra data of its own — but note
// that December comes from the *next* winter file, since DJF 2026 is Dec 2025.
const YEAR = 'YEAR';

const {
  sourceKey,
  dataEndpoint,
  index,
  preloaded,
  defaultSeason,
  defaultYears,
  defaultMeasure,
  defaultStat,
  defaultDetail,
} = Astro.props;

const seasonCodes = [...Object.keys(SEASON_NAMES).filter((code) => index[code]), YEAR];
const seasonLabel = { ...SEASON_NAMES, [YEAR]: 'Whole year' };

// Render the default view at build time so the chart is present before the
// controls hydrate; the client re-renders through the same functions.
const initialModel = buildModel({
  entries: defaultYears.map((year, position) => ({
    year,
    slot: position + 1,
    data: preloaded[defaultSeason][year],
  })),
  focus: defaultYears[0],
  measure: defaultMeasure,
  stat: defaultStat,
  detail: defaultDetail,
});
const initialSvg = renderSvg(initialModel);

const yearsFor = (code) =>
  Object.keys(index[code].years)
    .map(Number)
    .sort((a, b) => b - a);
// YEAR is assembled client-side and has no index entry of its own.
const allYears = [...new Set(Object.keys(index).flatMap(yearsFor))].sort((a, b) => b - a);
---

<section class="card explorer" data-explorer>
  <h2>Daily conditions by season</h2>
  <p class="card-sub">
    Compare up to {MAX_YEARS} years day for day. Clicking a year brings it to the front and shows
    its daily low–high band; clicking it again hides the band. The × removes it.
  </p>

  <div class="controls">
    <div class="control">
      <span class="control-label" id="season-label">Season</span>
      <div class="chips" role="group" aria-labelledby="season-label">
        {
          seasonCodes.map((code) => (
            <button
              type="button"
              data-season={code}
              aria-pressed={code === defaultSeason ? 'true' : 'false'}
            >
              {seasonLabel[code]}
            </button>
          ))
        }
      </div>
    </div>

    <div class="control">
      <span class="control-label" id="measure-label">Measure</span>
      <div class="chips" role="group" aria-labelledby="measure-label">
        {
          MEASURES.map((measure) => (
            <button
              type="button"
              data-measure={measure.key}
              aria-pressed={measure.key === defaultMeasure ? 'true' : 'false'}
            >
              {measure.label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="control">
      <span class="control-label" id="detail-label">Detail</span>
      <div class="chips" role="group" aria-labelledby="detail-label">
        {
          DETAILS.map((detail) => (
            <button
              type="button"
              data-detail={detail.key}
              aria-pressed={detail.key === defaultDetail ? 'true' : 'false'}
            >
              {detail.label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="control" data-stat-control>
      <span class="control-label" id="stat-label">Series</span>
      <div class="chips" role="group" aria-labelledby="stat-label">
        {
          STATS.map((stat) => (
            <button
              type="button"
              data-stat={stat.key}
              aria-pressed={stat.key === defaultStat ? 'true' : 'false'}
            >
              {stat.label}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <div class="control years">
    <div class="years-head">
      <span class="control-label" id="years-label">
        Years <em data-year-count>{defaultYears.length} of {MAX_YEARS}</em>
      </span>
      <button type="button" class="clear" data-clear>Clear all</button>
    </div>
    <div class="chips chips-years" role="group" aria-labelledby="years-label">
      {
        allYears.map((year) => (
          <span class="chip" data-chip={year}>
            <button type="button" data-year={year} aria-pressed="false">
              {year}
            </button>
            <button type="button" data-remove={year} aria-label={`Remove ${year}`} hidden>
              <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                <path d="M3.5 3.5l5 5M8.5 3.5l-5 5" />
              </svg>
            </button>
          </span>
        ))
      }
    </div>
  </div>

  <figure class="chart">
    <div class="legend" data-legend></div>
    <svg
      viewBox={`0 0 ${W} ${H}`}
      role="img"
      data-chart
      aria-label="Daily conditions for the selected season and years"
      set:html={initialSvg}
    />
    <div class="tooltip" hidden></div>
    <p class="chart-note" data-note></p>
  </figure>

  <details class="table-view">
    <summary>View the plotted series as a table</summary>
    <div class="table-scroll" data-table></div>
  </details>

  <script type="application/json" data-index set:html={JSON.stringify(index)} />
  <script type="application/json" data-preloaded set:html={JSON.stringify(preloaded)} />
  <script
    type="application/json"
    data-initial
    set:html={JSON.stringify({
      source: sourceKey,
      endpoint: dataEndpoint,
      season: defaultSeason,
      measure: defaultMeasure,
      stat: defaultStat,
      detail: defaultDetail,
      years: defaultYears,
      seasonCodes,
      seasonLabel,
    })}
  />
</section>

<style>
  .explorer {
    padding-bottom: 1.4rem;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }

  .control-label {
    display: block;
    margin-bottom: 0.4rem;
    color: var(--text-secondary);
    font-size: 0.8rem;
  }

  .control-label em {
    color: var(--text-muted);
    font-style: normal;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  /* Fabra runs from 1913, so the year row can be a hundred chips long. */
  .chips-years {
    max-height: 8.5rem;
    overflow-y: auto;
  }

  .explorer[data-loading] .chart {
    opacity: 0.45;
    transition: opacity 120ms ease;
  }

  .explorer[data-loading] svg[data-chart] {
    pointer-events: none;
  }

  .chips button {
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--text-secondary);
    font: inherit;
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }

  .chips button:hover:not(:disabled) {
    border-color: var(--axis);
    color: var(--text-primary);
  }

  /* Season, measure and series pills only — year chips carry their own selected
     state below, and these would otherwise out-specify it. */
  .chips:not(.chips-years) button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .chips:not(.chips-years) button[aria-pressed='true'] {
    border-color: var(--text-primary);
    background: var(--text-primary);
    color: var(--surface-1);
  }

  .years {
    margin-bottom: 1.4rem;
  }

  .years-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
  }

  .years-head .control-label {
    margin-bottom: 0;
  }

  .clear {
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-muted);
    font: inherit;
    font-size: 0.78rem;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }

  .clear:hover {
    color: var(--text-primary);
  }

  /* The pill is the wrapper so the year and its remove button share one border
     — nesting a button inside a button would be invalid. */
  .chip {
    display: inline-flex;
    align-items: stretch;
    border: 1px solid var(--border);
    border-radius: 999px;
    overflow: hidden;
  }

  .chip button {
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--text-secondary);
    font: inherit;
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }

  .chip button[data-year] {
    padding: 0.3rem 0.75rem;
  }

  .chip:hover:not([data-disabled]) {
    border-color: var(--axis);
  }

  .chip button:hover:not(:disabled) {
    color: var(--text-primary);
  }

  .chip[data-disabled] {
    opacity: 0.35;
  }

  .chip[data-disabled] button {
    cursor: not-allowed;
  }

  /* A selected year wears its series colour; the front year is filled. */
  .chip[data-selected] {
    border-color: var(--series);
  }

  .chip[data-selected] button[data-year] {
    color: var(--text-primary);
    padding-right: 0.4rem;
  }

  .chip[data-focus] {
    background: var(--series);
  }

  /* Ink on a filled chip, not a text token: the fill is a series colour in both
     modes, and black clears 4.5:1 on all five (blue is tightest at 4.71).
     Specificity has to beat both [data-selected] and [data-remove] below. */
  .chip[data-focus] button[data-year],
  .chip[data-focus] button[data-remove] {
    color: #0b0b0b;
  }

  .chip button[data-remove] {
    display: flex;
    align-items: center;
    padding: 0 0.55rem 0 0.15rem;
    color: var(--text-muted);
  }

  /* `display: flex` above would otherwise beat the [hidden] attribute. */
  .chip button[data-remove][hidden] {
    display: none;
  }

  .chip button[data-remove] svg {
    width: 12px;
    height: 12px;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    fill: none;
  }

  .chip button[data-remove]:hover {
    color: var(--text-primary);
  }

  .chip[data-focus] button[data-remove]:hover {
    opacity: 0.75;
  }

  .chart {
    position: relative;
    margin: 0;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    min-height: 1.2rem;
    margin-bottom: 0.75rem;
    color: var(--text-secondary);
    font-size: 0.82rem;
  }

  .legend :global(.legend-item) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .legend :global(.legend-item em) {
    color: var(--text-muted);
    font-style: normal;
  }

  .legend :global(.key) {
    width: 16px;
    height: 2px;
    border-radius: 1px;
    background: var(--series);
    flex: none;
  }

  .legend :global(.key-band) {
    height: 10px;
    border-radius: 2px;
    opacity: 0.22;
  }

  .chart-note {
    margin: 0.5rem 0 0;
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  .chart-note:empty {
    display: none;
  }

  /* Scoped: the remove buttons hold their own inline <svg> icons. */
  svg[data-chart] {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    touch-action: pan-y;
  }

  svg[data-chart] :global(.grid line) {
    stroke: var(--grid);
    stroke-width: 1;
  }

  svg[data-chart] :global(.baseline) {
    stroke: var(--axis);
    stroke-width: 1;
  }

  svg[data-chart] :global(.band) {
    fill: var(--series);
    fill-opacity: 0.13;
  }

  svg[data-chart] :global(.line) {
    fill: none;
    stroke: var(--series);
    stroke-width: 1.6;
    stroke-linejoin: round;
    stroke-linecap: round;
    opacity: 0.75;
  }

  svg[data-chart] :global(.line.is-focus) {
    stroke-width: 2.4;
    opacity: 1;
  }

  svg[data-chart] :global(.end-dot) {
    fill: var(--series);
    stroke: var(--surface-1);
    stroke-width: 2;
  }

  svg[data-chart] :global(.end-label) {
    fill: var(--text-primary);
    font-size: 12px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  svg[data-chart] :global(.tick text) {
    fill: var(--text-muted);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  svg[data-chart] :global(.empty) {
    fill: var(--text-muted);
    font-size: 14px;
  }

  svg[data-chart] :global(.crosshair) {
    opacity: 0;
    pointer-events: none;
  }

  .chart.is-active svg[data-chart] :global(.crosshair) {
    opacity: 1;
  }

  svg[data-chart] :global(.crosshair line) {
    stroke: var(--axis);
    stroke-width: 1;
  }

  svg[data-chart] :global(.crosshair circle) {
    fill: var(--series);
    stroke: var(--surface-1);
    stroke-width: 2;
  }

  .tooltip {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    pointer-events: none;
    display: grid;
    gap: 0.15rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface-1);
    color: var(--text-secondary);
    font-size: 0.78rem;
    line-height: 1.35;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.08);
  }

  .tooltip :global(strong) {
    color: var(--text-primary);
  }

  .tooltip :global(.row) {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .tooltip :global(.row-focus) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .tooltip :global(.swatch) {
    width: 10px;
    height: 2px;
    border-radius: 1px;
    background: var(--series);
    flex: none;
  }

  /* `display: grid` above would otherwise beat the [hidden] attribute. */
  .tooltip[hidden] {
    display: none;
  }

  .table-view {
    margin-top: 1.5rem;
  }

  .table-view summary {
    cursor: pointer;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .table-view .table-scroll {
    max-height: 420px;
    overflow: auto;
    margin-top: 1rem;
  }

  .table-view :global(thead th) {
    position: sticky;
    top: 0;
    background: var(--surface-1);
  }
</style>

<script>
  import {
    buildModel,
    renderSvg,
    makeScale,
    formatValue,
    measureOf,
    detailOf,
    xAt,
    addDays,
    dayOf,
    MAX_YEARS,
    MEASURES,
    STATS,
    DETAILS,
    SEASON_NAMES,
    SERIES_SLOTS,
    W,
    PAD,
    PLOT_W,
  } from '../lib/season-chart.js';

  const root = document.querySelector('[data-explorer]');

  if (root) {
    const index = JSON.parse(root.querySelector('[data-index]').textContent);
    const initial = JSON.parse(root.querySelector('[data-initial]').textContent);

    // Season payloads arrive from /data/<source>/<season>.json. The season the
    // page opened on is already inlined, so the first paint costs no request.
    const cache = JSON.parse(root.querySelector('[data-preloaded]').textContent);
    const pending = new Map();

    function loadSeason(code) {
      if (cache[code]) return Promise.resolve(cache[code]);
      if (pending.has(code)) return pending.get(code);

      const request = fetch(`${initial.endpoint}/${code}.json`)
        .then((response) => {
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          return response.json();
        })
        .then((years) => {
          cache[code] = years;
          pending.delete(code);
          return years;
        })
        .catch((error) => {
          pending.delete(code);
          throw error;
        });

      pending.set(code, request);
      return request;
    }

    const svg = root.querySelector('[data-chart]');
    const figure = root.querySelector('.chart');
    const legend = root.querySelector('[data-legend]');
    const tooltip = root.querySelector('.tooltip');
    const note = root.querySelector('[data-note]');
    const tableHost = root.querySelector('[data-table]');
    const yearCount = root.querySelector('[data-year-count]');

    const seasonButtons = [...root.querySelectorAll('[data-season]')];
    const measureButtons = [...root.querySelectorAll('[data-measure]')];
    const statButtons = [...root.querySelectorAll('[data-stat]')];
    const detailButtons = [...root.querySelectorAll('[data-detail]')];
    const statControl = root.querySelector('[data-stat-control]');
    // Scoped to the chip row: the chart's own <path class="line"> elements also
    // carry data-year, and an unscoped selector would bind handlers to SVG
    // nodes that innerHTML replaces on the next render.
    const yearButtons = [...root.querySelectorAll('.chips-years [data-year]')];
    const removeButtons = [...root.querySelectorAll('[data-remove]')];
    const clearButton = root.querySelector('[data-clear]');
    const chips = new Map(
      [...root.querySelectorAll('[data-chip]')].map((chip) => [Number(chip.dataset.chip), chip])
    );

    const YEAR = 'YEAR';
    const REAL_SEASONS = Object.keys(index);
    const isLeap = (y) => (y % 4 === 0 && y % 100 !== 0) || y % 400 === 0;

    /**
     * Stitch one calendar year together from the season files. December comes
     * from the *following* winter, since DJF 2026 is Dec 2025 + Jan/Feb 2026 —
     * so a year needs five season-years, not four.
     */
    // Days before each month in a common (non-leap) year.
    const MONTH_OFFSET = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];

    function assembleYear(year) {
      // A fixed 365-slot calendar with 29 February dropped. Placing the leap
      // day at its natural index would shift March onwards by one in leap years
      // only, so overlaying 2024 on 2025 would compare adjacent days — the same
      // trap the season files avoid by parking the leap day at the end of DJF.
      const LENGTH = 365;
      const blank = () => new Array(LENGTH).fill(null);
      const out = {
        start: `${year}-01-01`,
        days: LENGTH,
        complete: true,
        dates: Array.from({ length: LENGTH }, (_, slot) => {
          let month = 11;
          while (month > 0 && MONTH_OFFSET[month] > slot) month -= 1;
          const day = slot - MONTH_OFFSET[month] + 1;
          return `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        }),
        tas: { min: blank(), mean: blank(), max: blank() },
        pr: { sum: blank() },
      };

      let seen = 0;
      for (const code of REAL_SEASONS) {
        // December belongs to the *following* winter file: DJF 2026 is
        // Dec 2025 + Jan/Feb 2026, so a year needs five season-years, not four.
        for (const seasonYear of [year, year + 1]) {
          const data = cache[code]?.[seasonYear];
          if (!data) continue;
          for (let i = 0; i < data.days; i++) {
            const iso = addDays(data.start, i);
            if (!iso.startsWith(`${year}-`)) continue;
            const month = Number(iso.slice(5, 7));
            const day = Number(iso.slice(8, 10));
            if (month === 2 && day === 29) continue;
            const slot = MONTH_OFFSET[month - 1] + day - 1;
            out.tas.min[slot] = data.tas.min[i];
            out.tas.mean[slot] = data.tas.mean[i];
            out.tas.max[slot] = data.tas.max[i];
            out.pr.sum[slot] = data.pr.sum[i];
            seen += 1;
          }
        }
      }
      if (!seen) return null;
      out.complete = seen >= LENGTH;
      return out;
    }

    const state = {
      season: initial.season,
      measure: initial.measure,
      stat: initial.stat,
      detail: initial.detail,
      // Ordered oldest-selected first; each entry keeps its colour slot.
      selected: initial.years.map((year, index) => ({ year, slot: index + 1 })),
      focus: initial.years[0],
    };

    let model = null;

    // Availability comes from the inlined index, so chips are correct before any
    // season payload has been fetched.
    const isAvailable = (year) =>
      state.season === YEAR
        ? REAL_SEASONS.some((code) => index[code]?.years[year])
        : Boolean(index[state.season]?.years[year]);

    const yearCache = new Map();
    function dataFor(year) {
      if (state.season !== YEAR) return cache[state.season]?.[year];
      const key = `${year}`;
      if (!yearCache.has(key)) yearCache.set(key, assembleYear(year));
      return yearCache.get(key);
    }
    const spec = () => measureOf(state.measure);

    function freeSlot() {
      const taken = new Set(state.selected.map((entry) => entry.slot));
      return SERIES_SLOTS.find((slot) => !taken.has(slot)) ?? SERIES_SLOTS[0];
    }

    function entries() {
      return state.selected
        .map((entry) => ({ ...entry, data: dataFor(entry.year) }))
        .filter((entry) => entry.data);
    }

    /**
     * Selecting is always additive — removal is the × button's job alone.
     * Clicking the year that is already at the front instead clears the focus,
     * which drops the band while leaving every series plotted.
     */
    function selectYear(year) {
      if (!isAvailable(year)) return;

      if (!state.selected.some((entry) => entry.year === year)) {
        if (state.selected.length >= MAX_YEARS) return;
        state.selected.push({ year, slot: freeSlot() });
        state.focus = year;
      } else {
        state.focus = state.focus === year ? null : year;
      }
      render();
    }

    function removeYear(year) {
      state.selected = state.selected.filter((entry) => entry.year !== year);
      // Don't silently promote another year — the band appears when a year is
      // clicked, and only then.
      if (state.focus === year) state.focus = null;
      render();
    }

    function clearYears() {
      state.selected = [];
      state.focus = null;
      render();
    }

    async function setSeason(season) {
      state.season = season;
      // Years absent from the new season drop out, freeing their slots.
      state.selected = state.selected.filter((entry) => isAvailable(entry.year));
      if (!state.selected.some((entry) => entry.year === state.focus)) {
        state.focus = null;
      }
      // Repaint the controls immediately so the click feels answered, then wait
      // on the payload.
      renderControls();

      // The year view is stitched from all four seasons, so it needs all four.
      const needed = (season === YEAR ? REAL_SEASONS : [season]).filter((c) => !cache[c]);
      if (needed.length) {
        const label = initial.seasonLabel?.[season] ?? season;
        root.dataset.loading = '';
        note.textContent = `Loading ${label}…`;
        try {
          await Promise.all(needed.map(loadSeason));
          yearCache.clear();
        } catch {
          delete root.dataset.loading;
          note.textContent = `Could not load ${label}. Check your connection and try again.`;
          return;
        }
        delete root.dataset.loading;
      }

      // A later click may have won the race while this payload was in flight.
      if (state.season !== season) return;
      render();
    }

    function renderLegend(current) {
      if (!current) {
        legend.innerHTML = '';
        return;
      }
      const items = current.series.map((series) => {
        const data = dataFor(series.year);
        const partial = data.days < current.maxDays;
        return (
          `<span class="legend-item" style="--series:var(--series-${series.slot})">` +
          `<span class="key"></span>${series.year}` +
          (partial ? `<em>to ${dayOf(addDays(data.start, data.days - 1))}</em>` : '') +
          '</span>'
        );
      });

      if (current.banded) {
        const focus = current.series.find((series) => series.isFocus);
        items.push(
          `<span class="legend-item" style="--series:var(--series-${focus.slot})">` +
            `<span class="key key-band"></span>${focus.year} daily low–high</span>`
        );
      }
      legend.innerHTML = items.join('');
    }

    function renderTable(current) {
      if (!current) {
        tableHost.innerHTML = '';
        return;
      }
      const measure = spec();
      const head =
        '<tr><th scope="col">Date</th>' +
        current.series.map((series) => `<th scope="col">${series.year}</th>`).join('') +
        '</tr>';

      const columns = current.series.map((series) => series.values);

      const rows = [];
      for (let i = 0; i < current.maxDays; i++) {
        const cells = columns
          .map((values) => `<td>${formatValue(values[i], state.measure)}</td>`)
          .join('');
        rows.push(
          `<tr><th scope="row">${dayOf(current.dates[i])}</th>${cells}</tr>`
        );
      }

      const caption = measure.cumulative
        ? `Cumulative precipitation through the season, in ${measure.unit}`
        : `Daily ${STATS.find((stat) => stat.key === state.stat).label.toLowerCase()} ` +
          `${measure.label.toLowerCase()}, in ${measure.unit}`;

      tableHost.innerHTML =
        `<table><caption class="sr-only">${caption}</caption>` +
        `<thead>${head}</thead><tbody>${rows.join('')}</tbody></table>`;
    }

    function renderControls() {
      seasonButtons.forEach((button) =>
        button.setAttribute('aria-pressed', String(button.dataset.season === state.season))
      );
      measureButtons.forEach((button) =>
        button.setAttribute('aria-pressed', String(button.dataset.measure === state.measure))
      );
      statButtons.forEach((button) =>
        button.setAttribute('aria-pressed', String(button.dataset.stat === state.stat))
      );
      // Smoothing a running total does nothing, so rather than let the chip
      // look active while the chart ignores it, take the option away.
      const smoothable = !spec().cumulative;
      detailButtons.forEach((button) => {
        const mode = DETAILS.find((d) => d.key === button.dataset.detail);
        const usable = smoothable || !mode?.smooth;
        button.disabled = !usable;
        button.title = usable ? '' : 'Not applicable to a running total';
        button.setAttribute(
          'aria-pressed',
          String(usable && button.dataset.detail === state.detail)
        );
      });
      // A daily total has no min/mean/max to choose between.
      statControl.hidden = !spec().stats;

      const atLimit = state.selected.length >= MAX_YEARS;
      yearButtons.forEach((button) => {
        const year = Number(button.dataset.year);
        const chip = chips.get(year);
        const entry = state.selected.find((item) => item.year === year);
        const available = isAvailable(year);

        button.disabled = !available || (!entry && atLimit);
        button.setAttribute('aria-pressed', String(Boolean(entry)));
        chip.querySelector('[data-remove]').hidden = !entry;
        chip.toggleAttribute('data-disabled', button.disabled);

        if (entry) {
          chip.dataset.selected = '';
          chip.style.setProperty('--series', `var(--series-${entry.slot})`);
          if (state.focus === year) chip.dataset.focus = '';
          else delete chip.dataset.focus;
        } else {
          delete chip.dataset.selected;
          delete chip.dataset.focus;
          chip.style.removeProperty('--series');
        }
      });

      yearCount.textContent = `${state.selected.length} of ${MAX_YEARS}`;
      clearButton.hidden = state.selected.length === 0;
    }

    function render() {
      model = buildModel({
        entries: entries(),
        focus: state.focus,
        measure: state.measure,
        stat: state.stat,
        detail: state.detail,
      });
      svg.innerHTML = renderSvg(model);

      const measure = spec();
      const statLabel = STATS.find((stat) => stat.key === state.stat).label.toLowerCase();
      svg.setAttribute(
        'aria-label',
        model
          ? `${measure.cumulative ? 'Cumulative' : `Daily ${statLabel}`} ${measure.label.toLowerCase()} ` +
              `in Barcelona for ${SEASON_NAMES[state.season]}, comparing ` +
              `${model.series.map((series) => series.year).join(', ')}.`
          : 'No years selected'
      );

      note.textContent = measure.cumulative
        ? 'Precipitation accumulates across the season — five years of daily totals overlaid would be unreadable. Hover for a single day’s rainfall.'
        : '';

      renderLegend(model);
      renderControls();
      renderTable(model);
      hide();
    }

    function move(event) {
      // Mid-load the model still describes the previous season while dataFor()
      // already points at the new one, so readings would not line up.
      if (!model || 'loading' in root.dataset) return;
      const rect = svg.getBoundingClientRect();
      if (!rect.width) return;

      const ratio = (((event.clientX - rect.left) / rect.width) * W - PAD.left) / PLOT_W;
      const i = Math.max(0, Math.min(model.maxDays - 1, Math.round(ratio * (model.maxDays - 1))));

      const y = makeScale(model.domain);
      const x = xAt(i, model.maxDays);
      const crossLine = svg.querySelector('.crosshair line');
      const dots = [...svg.querySelectorAll('.crosshair circle')];
      const measure = spec();

      const rows = model.series.map((series, index) => {
        const value = series.values[i];
        const dot = dots[index];

        if (value == null) {
          dot.setAttribute('opacity', '0');
          return '';
        }
        dot.setAttribute('opacity', '1');
        dot.setAttribute('cx', x);
        dot.setAttribute('cy', y(value));

        let extra = '';
        if (measure.cumulative) {
          // The plotted line is a running total, so name what this period added.
          const added = value - (i > 0 ? (series.values[i - 1] ?? value) : 0);
          extra = added ? ` (+${formatValue(added, state.measure)})` : '';
        } else if (series.isFocus && series.low && series.high) {
          const low = formatValue(series.low[i], state.measure);
          const high = formatValue(series.high[i], state.measure);
          extra = ` (${low}–${high})`;
        }

        return (
          `<span class="row${series.isFocus ? ' row-focus' : ''}" ` +
          `style="--series:var(--series-${series.slot})">` +
          `<span class="swatch"></span>${series.year} · ` +
          `${formatValue(value, state.measure)}${measure.suffix}${extra}</span>`
        );
      });

      crossLine.setAttribute('x1', x);
      crossLine.setAttribute('x2', x);
      figure.classList.add('is-active');
      tooltip.hidden = false;
      tooltip.innerHTML = `<strong>${dayOf(model.dates[i])}</strong>${rows.join('')}`;

      const half = tooltip.offsetWidth / 2;
      const px = (x / W) * rect.width;
      tooltip.style.left = `${Math.max(half, Math.min(rect.width - half, px))}px`;
    }

    function hide() {
      figure.classList.remove('is-active');
      tooltip.hidden = true;
    }

    seasonButtons.forEach((button) =>
      button.addEventListener('click', () => setSeason(button.dataset.season))
    );
    measureButtons.forEach((button) =>
      button.addEventListener('click', () => {
        state.measure = button.dataset.measure;
        // Leaving a smoothing mode selected under a running total would show a
        // pressed chip that does nothing; fall back to daily.
        if (measureOf(state.measure).cumulative && detailOf(state.detail).smooth) {
          state.detail = 'daily';
        }
        render();
      })
    );
    statButtons.forEach((button) =>
      button.addEventListener('click', () => {
        state.stat = button.dataset.stat;
        render();
      })
    );
    detailButtons.forEach((button) =>
      button.addEventListener('click', () => {
        state.detail = button.dataset.detail;
        render();
      })
    );
    yearButtons.forEach((button) =>
      button.addEventListener('click', () => selectYear(Number(button.dataset.year)))
    );
    removeButtons.forEach((button) =>
      button.addEventListener('click', () => removeYear(Number(button.dataset.remove)))
    );
    clearButton.addEventListener('click', clearYears);

    svg.addEventListener('pointermove', move);
    svg.addEventListener('pointerdown', move);
    svg.addEventListener('pointerleave', hide);

    render();
  }
</script>
