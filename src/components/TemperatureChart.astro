---
import { niceTicks, r2, monthLabel, dayLabel } from '../lib/chart.js';

const { daily, units } = Astro.props;

const time = daily.time;
const mean = daily.temperature_2m_mean;
const high = daily.temperature_2m_max;
const low = daily.temperature_2m_min;
const n = time.length;
const last = n - 1;

const W = 900;
const H = 340;
// Right padding leaves room for the end label so it never clips.
const PAD = { top: 16, right: 58, bottom: 28, left: 42 };
const plotW = W - PAD.left - PAD.right;
const plotH = H - PAD.top - PAD.bottom;

const scale = niceTicks(Math.min(...low), Math.max(...high), 5);
const xAt = (i) => PAD.left + (i / (n - 1)) * plotW;
const yAt = (v) => PAD.top + (1 - (v - scale.min) / (scale.max - scale.min)) * plotH;

// The band runs along the highs left-to-right, then back along the lows.
let bandPath = '';
for (let i = 0; i < n; i++) bandPath += `${i ? 'L' : 'M'}${r2(xAt(i))},${r2(yAt(high[i]))}`;
for (let i = last; i >= 0; i--) bandPath += `L${r2(xAt(i))},${r2(yAt(low[i]))}`;
bandPath += 'Z';

let meanPath = '';
for (let i = 0; i < n; i++) meanPath += `${i ? 'L' : 'M'}${r2(xAt(i))},${r2(yAt(mean[i]))}`;

const monthTicks = time
  .map((iso, i) => ({ iso, i }))
  .filter(({ iso }) => iso.endsWith('-01'))
  .map(({ iso, i }) => ({ x: r2(xAt(i)), label: monthLabel(iso) }));

const baselineY = PAD.top + plotH;
const unit = units.temperature_2m_mean;

// Only the geometry and values the hover layer needs.
const clientConfig = {
  time,
  mean,
  high,
  low,
  unit,
  W,
  padLeft: PAD.left,
  padTop: PAD.top,
  plotW,
  plotH,
  yMin: scale.min,
  yMax: scale.max,
};
---

<figure class="chart" data-chart="temperature">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label={`Daily temperature in Barcelona, ${dayLabel(time[0])} to ${dayLabel(time[last])}. Daily mean ranged from ${Math.min(...mean)}${unit} to ${Math.max(...mean)}${unit}.`}
  >
    <g class="grid">
      {
        scale.ticks.map((tick) => (
          <line x1={PAD.left} x2={W - PAD.right} y1={r2(yAt(tick))} y2={r2(yAt(tick))} />
        ))
      }
    </g>

    <path class="band" d={bandPath} />
    <path class="line" d={meanPath} />

    <line class="baseline" x1={PAD.left} x2={W - PAD.right} y1={baselineY} y2={baselineY} />

    <g class="tick y">
      {
        scale.ticks.map((tick) => (
          <text x={PAD.left - 10} y={r2(yAt(tick)) + 4} text-anchor="end">
            {tick}°
          </text>
        ))
      }
    </g>
    <g class="tick x">
      {
        monthTicks.map((tick) => (
          <text x={tick.x} y={H - 8} text-anchor="middle">
            {tick.label}
          </text>
        ))
      }
    </g>

    <g class="crosshair">
      <line y1={PAD.top} y2={baselineY} x1="0" x2="0" />
      <circle r="4" cx="0" cy="0" />
    </g>

    <circle class="end-dot" cx={r2(xAt(last))} cy={r2(yAt(mean[last]))} r="4" />
    <text class="end-label" x={r2(xAt(last)) + 11} y={r2(yAt(mean[last])) + 4}>{mean[last]}°</text>
  </svg>

  <div class="tooltip" hidden></div>
  <script type="application/json" set:html={JSON.stringify(clientConfig)}></script>
</figure>

<style>
  .chart {
    position: relative;
    margin: 0;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    touch-action: pan-y;
  }

  .grid line {
    stroke: var(--grid);
    stroke-width: 1;
  }

  .baseline {
    stroke: var(--axis);
    stroke-width: 1;
  }

  .band {
    fill: var(--series-temp);
    fill-opacity: 0.13;
  }

  .line {
    fill: none;
    stroke: var(--series-temp);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .end-dot {
    fill: var(--series-temp);
    stroke: var(--surface-1);
    stroke-width: 2;
  }

  /* Labels wear text tokens — the coloured mark beside them carries identity. */
  .end-label {
    fill: var(--text-primary);
    font-size: 13px;
    font-weight: 600;
  }

  .tick text {
    fill: var(--text-muted);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .crosshair {
    opacity: 0;
    pointer-events: none;
  }

  .chart.is-active .crosshair {
    opacity: 1;
  }

  .crosshair line {
    stroke: var(--axis);
    stroke-width: 1;
  }

  .crosshair circle {
    fill: var(--series-temp);
    stroke: var(--surface-1);
    stroke-width: 2;
  }

  .tooltip {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    pointer-events: none;
    display: grid;
    gap: 0.1rem;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface-1);
    color: var(--text-secondary);
    font-size: 0.78rem;
    line-height: 1.35;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.08);
  }

  .tooltip :global(strong) {
    color: var(--text-primary);
  }

  /* `display: grid` above would otherwise beat the [hidden] attribute. */
  .tooltip[hidden] {
    display: none;
  }
</style>

<script>
  const root = document.querySelector('[data-chart="temperature"]');

  if (root) {
    const svg = root.querySelector('svg');
    const tooltip = root.querySelector('.tooltip');
    const crosshair = root.querySelector('.crosshair');
    const crossLine = crosshair.querySelector('line');
    const crossDot = crosshair.querySelector('circle');
    const cfg = JSON.parse(root.querySelector('script[type="application/json"]').textContent);

    const n = cfg.time.length;
    const xAt = (i) => cfg.padLeft + (i / (n - 1)) * cfg.plotW;
    const yAt = (v) => cfg.padTop + (1 - (v - cfg.yMin) / (cfg.yMax - cfg.yMin)) * cfg.plotH;

    const dateFmt = new Intl.DateTimeFormat('en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
    });

    function move(event) {
      const rect = svg.getBoundingClientRect();
      const ratio = (((event.clientX - rect.left) / rect.width) * cfg.W - cfg.padLeft) / cfg.plotW;
      const i = Math.max(0, Math.min(n - 1, Math.round(ratio * (n - 1))));

      const x = xAt(i);
      crossLine.setAttribute('x1', x);
      crossLine.setAttribute('x2', x);
      crossDot.setAttribute('cx', x);
      crossDot.setAttribute('cy', yAt(cfg.mean[i]));
      root.classList.add('is-active');

      tooltip.hidden = false;
      tooltip.innerHTML =
        `<strong>${dateFmt.format(new Date(`${cfg.time[i]}T00:00:00Z`))}</strong>` +
        `<span>Mean ${cfg.mean[i]}${cfg.unit}</span>` +
        `<span>High ${cfg.high[i]}${cfg.unit} · Low ${cfg.low[i]}${cfg.unit}</span>`;

      // Keep the tooltip inside the figure instead of letting it run off an edge.
      const half = tooltip.offsetWidth / 2;
      const px = (x / cfg.W) * rect.width;
      tooltip.style.left = `${Math.max(half, Math.min(rect.width - half, px))}px`;
    }

    function hide() {
      root.classList.remove('is-active');
      tooltip.hidden = true;
    }

    svg.addEventListener('pointermove', move);
    svg.addEventListener('pointerdown', move);
    svg.addEventListener('pointerleave', hide);
  }
</script>
